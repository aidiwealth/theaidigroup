# Copy to .env for local work. In production set these in App Platform (encrypted).
# Connect as the website_intake role, not the admin user.
DATABASE_URL=postgresql://website_intake:PASSWORD@HOST:25060/aidi_os?sslmode=require
# DigitalOcean database CA certificate (PEM). Required in production.
DATABASE_CA=
RESEND_API_KEY=
FORMS_FROM=The Aidi Group <website@theaidigroup.com>
FORMS_TO_PITCH=
FORMS_TO_SERVICES=
FORMS_TO_CONTACT=
# Cloudflare Turnstile. These test keys always pass; use real keys in production.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
